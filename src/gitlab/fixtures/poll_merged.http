me":"gitlab-advanced-sast","status":"SUCCESS","webPath":"/gitlab-org/cli/-/jobs/17300459978"}]},"mergeRequestEventType":"MERGE_TRAIN","path":"/gitlab-org/cli/-/pipelines/2965322761","sha":"ec1adbb9c1edbf4afe2d3ef394ac1b5855a3d0fa","status":"SUCCESS"},"mergeUser":{"bot":false,"id":"gid://gitlab/User/2935693","username":"phikai"},"mergedAt":"2026-10-19T23:03:24Z","project":{"allowMergeOnSkippedPipeline":false},"projectId":34675721,"shouldBeRebased":false,"state":"merged","approvedBy":{"pageInfo":{"hasNextPage":false,"endCursor":"eyJpZCI6IjI5MzU2OTMifQ"},"nodes":[{"bot":true,"id":"gid://gitlab/User/21826781","username":"GitLabDuo"},{"bot":false,"id":"gid://gitlab/User/2935693","username":"phikai"}]},"notes":{"pageInfo":{"hasNextPage":false,"endCursor":"eyJjcmVhdGVkX2F0IjoiMjAyNi0xMC0xOSAxNTo0NToyMC40OTU4MzQwMDAgKzAwMDAiLCJpZCI6IjQwNDM4ODQ0MzkifQ"},"nodes":[{"author":{"bot":true,"id":"gid://gitlab/User/21826781","username":"GitLabDuo"},"body":"I finished my review and found nothing to comment on. Nice work! :tada:\n\n- Command change: `--internal` is a plain bool flag. It sets `Internal` on `CreateIssueNoteOptions` only when passed, so public notes send the same request as before.\n- Scope: the shared `NewCmdNote` covers both `issue note` and `incident note`, and the generated docs for both commands list the new flag and example.\n- Flag text: the description and example follow the repo's help-text conventions, with a capital letter, a period, and an annotated example.\n- Tests: the existing no-flag test now asserts `Internal` is nil. A new test checks the flag sends `Internal=true` for each issue type, so both paths are covered.","createdAt":"2026-10-19T05:40:47Z","discussion":{"id":"gid://gitlab/Discussion/2cb6fa2217d1e7f79aae3b5b9c84c25bf7175ed8","resolvable":false,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/Note/4039724626","lastEditedAt":"2026-10-19T05:40:47Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4149#note_4039724626"},{"author":{"bot":false,"id":"gid://gitlab/User/11809982","username":"jay_mccure"},"body":"Hi @phikai :wave: would you mind reviewing this small feature addition? Thanks :bow:","createdAt":"2026-10-19T05:49:05Z","discussion":{"id":"gid://gitlab/Discussion/1737b072eb3c6a9bf92c535a6794872f4d60f4e4","resolvable":false,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/Note/4039753485","lastEditedAt":"2026-10-19T05:49:05Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4149#note_4039753485"},{"author":{"bot":false,"id":"gid://gitlab/User/2935693","username":"phikai"},"body":"Approving. `--internal` matches `glab mr note create`: same flag name and description, and `Internal` is set only when the flag is passed, so public notes send an unchanged request. The change follows the plan in #8584, and the tests cover both the flag and the no-flag case for `issue` and `incident`.","createdAt":"2026-10-19T15:45:20Z","discussion":{"id":"gid://gitlab/Discussion/396dd1a65f2e56f5accd55831baa6783269f645d","resolvable":true,"resolved":true,"resolvedBy":{"bot":false,"id":"gid://gitlab/User/11809982","username":"jay_mccure"}},"id":"gid://gitlab/DiscussionNote/4043884439","lastEditedAt":"2026-10-19T22:43:34Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4149#note_4043884439"}]},"reviewers":{"pageInfo":{"hasNextPage":false,"endCursor":"eyJpZCI6IjI5MzU2OTMifQ"},"nodes":[{"bot":true,"id":"gid://gitlab/User/21826781","username":"GitLabDuo","mergeRequestInteraction":{"reviewState":"APPROVED"}},{"bot":false,"id":"gid://gitlab/User/2935693","username":"phikai","mergeRequestInteraction":{"reviewState":"APPROVED"}}]}}}}