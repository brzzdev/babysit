e,"id":"gid://gitlab/Ci::Build/17323965267","name":"check_go_generated_code","status":"SUCCESS","webPath":"/Zaygalx1/cli/-/jobs/17323965267"},{"allowFailure":true,"id":"gid://gitlab/Ci::Build/17323965266","name":"govulncheck","status":"MANUAL","webPath":"/Zaygalx1/cli/-/jobs/17323965266"}]},"mergeRequestEventType":"DETACHED","path":"/Zaygalx1/cli/-/pipelines/2968588387","sha":"0295354207bd41654f5fbcd3cd8dc2155bf7142b","status":"SUCCESS"},"mergeUser":null,"mergedAt":null,"pipelines":{"nodes":[{"id":"gid://gitlab/Ci::Pipeline/2968588387","mergeRequestEventType":"DETACHED","path":"/Zaygalx1/cli/-/pipelines/2968588387","sha":"0295354207bd41654f5fbcd3cd8dc2155bf7142b","status":"SUCCESS"},{"id":"gid://gitlab/Ci::Pipeline/2968430583","mergeRequestEventType":"DETACHED","path":"/Zaygalx1/cli/-/pipelines/2968430583","sha":"a5d85948d141d0c448470c0c50b642cf7b0ed424","status":"SUCCESS"}]},"project":{"allowMergeOnSkippedPipeline":false},"projectId":34675721,"retargeted":false,"shouldBeRebased":false,"state":"opened","approvedBy":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[]},"notes":{"pageInfo":{"hasNextPage":false,"endCursor":"eyJjcmVhdGVkX2F0IjoiMjAyNi0xMC0yMCAxNjo0MTozMi44NzQ3NTYwMDAgKzAwMDAiLCJpZCI6IjQwNTIxNDU2MDgifQ"},"nodes":[{"author":{"bot":false,"id":"gid://gitlab/User/1786152","username":"gitlab-bot"},"body":"\u003c!-- triage-serverless ThankContribution --\u003e\nThanks for your contribution to GitLab @Zaygalx1! :tada:\n\nDid you know about our [community forks](https://gitlab.com/gitlab-community/meta)?\nWorking from there will make your contribution process easier. Please check it out!\n\n* Request a review, help or apply labels by [clicking here](https://contributors.gitlab.com/manage-merge-request?projectId=34675721\u0026mergeRequestIid=4158) or come say hi on [Discord](https://discord.gg/gitlab).\n* We welcome AI-generated contributions and offer [complimentary access to GitLab Duo](https://gitlab.com/gitlab-community/meta#gitlab-duo)!\n\n*This message was [generated automatically](https://handbook.gitlab.com/handbook/engineering/infrastructure/engineering-productivity/triage-operations).\n[Improve it](https://gitlab.com/gitlab-org/quality/triage-ops/-/blob/master/triage/processor/community/thank_contribution.rb)\nor [delete it](https://handbook.gitlab.com/handbook/engineering/infrastructure/engineering-productivity/triage-operations/#reactive-delete_bot_comment-command).*","createdAt":"2026-10-20T15:55:05Z","discussion":{"id":"gid://gitlab/Discussion/87f84d36dcc794894e55ca2918178b7e345303fc","resolvable":false,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/Note/4051829117","lastEditedAt":"2026-10-20T15:55:05Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4158#note_4051829117"},{"author":{"bot":false,"id":"gid://gitlab/User/43441234","username":"Zaygalx1"},"body":"Pipeline is green. The focused test fails with the renderer option removed and passes with it. Ready for review.","createdAt":"2026-10-20T16:08:19Z","discussion":{"id":"gid://gitlab/Discussion/50f0ef14f8de551e97ba603344e7f3595cd40949","resolvable":false,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/Note/4051924968","lastEditedAt":"2026-10-20T16:08:19Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4158#note_4051924968"},{"author":{"bot":true,"id":"gid://gitlab/User/31177744","username":"contributors.gitlab.com"},"body":"Hey @Zaygalx1, thanks for requesting a review!\n\nFeel free to address any feedback by `@GitLabDuo`, or wait for another reviewer to validate it first!\n\nHey @dblessing :wave:\n\n- Do you have capacity and domain expertise to review this? If not, find one or more [reviewers](https://gitlab-org.gitlab.io/gitlab-roulette/) and assign to them.\n- If you've reviewed it, add the ~\"workflow::in dev\" label if these changes need more work before the next review.\n- Please ensure the group's Product Manager has validated the linked issue.\n\n\u003c!--\n@gitlab-bot ready @GitLabDuo\n--\u003e\n\n\n\n_Posted via [contributors.gitlab.com](https://contributors.gitlab.com)._","createdAt":"2026-10-20T16:20:07Z","discussion":{"id":"gid://gitlab/Discussion/4858be2fea2364f8a7bb210b576327faefc30e99","resolvable":true,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/DiscussionNote/4052007060","lastEditedAt":"2026-10-20T16:20:07Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4158#note_4052007060"},{"author":{"bot":false,"id":"gid://gitlab/User/1786152","username":"gitlab-bot"},"body":"`@GitLabDuo`, this ~\"Community contribution\" is ready for review.\n\n- Do you have capacity and domain expertise to review this? If not, find one or more [reviewers](https://gitlab-org.gitlab.io/gitlab-roulette/) and assign to them.\n- If you've reviewed it, add the ~\"workflow::in dev\" label if these changes need more work before the next review.\n- Please ensure the group's Product Manager has validated the linked issue.\n\n*This message was [generated automatically](https://handbook.gitlab.com/handbook/engineering/infrastructure/engineering-productivity/triage-operations).\n[Improve it](https://gitlab.com/gitlab-org/quality/triage-ops/-/blob/master/triage/processor/community/command_mr_request_review.rb)\nor [delete it](https://handbook.gitlab.com/handbook/engineering/infrastructure/engineering-productivity/triage-operations/#reactive-delete_bot_comment-command).*","createdAt":"2026-10-20T16:21:18Z","discussion":{"id":"gid://gitlab/Discussion/4858be2fea2364f8a7bb210b576327faefc30e99","resolvable":true,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/DiscussionNote/4052015534","lastEditedAt":"2026-10-20T16:21:18Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4158#note_4052015534"},{"author":{"bot":true,"id":"gid://gitlab/User/21826781","username":"GitLabDuo"},"body":"The fix is small and does what the description says. I found one concern: the option is applied globally, so README, whatsnew and discussion-note rendering also change, and the MR description doesn't mention this.\n\n1 finding (1 major) across 1 file:\n\n**Major**\n- behavior-regression: `internal/utils/utils.go:65`","createdAt":"2026-10-20T16:23:43Z","discussion":{"id":"gid://gitlab/Discussion/87f1767fd9c18d7ff5221c28948597f12ce59c7c","resolvable":false,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/Note/4052031464","lastEditedAt":"2026-10-20T16:23:43Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4158#note_4052031464"},{"author":{"bot":true,"id":"gid://gitlab/User/21826781","username":"GitLabDuo"},"body":"**[Major] behavior-regression**\n\nThis option applies to every `renderMarkdown` caller, not just issue, MR and release content. Other callers include `project view` for the README and project description, `whatsnew` changelog, and MR discussion notes. Markdown that is hard-wrapped in the source, such as README paragraphs wrapped at 80 columns, will now render with a line break at each source newline. The MR description only mentions issues, MRs and releases. Did you check the README and whatsnew output? If those regress, make the option opt-in for the callers that need it. Also, the new test covers only `RenderMarkdown`, not a soft-wrap case or a fenced code block.","createdAt":"2026-10-20T16:23:43Z","discussion":{"id":"gid://gitlab/Discussion/d44541ed73cf1be763470408c067b2a2fd0e5b11","resolvable":true,"resolved":true,"resolvedBy":{"bot":false,"id":"gid://gitlab/User/43441234","username":"Zaygalx1"}},"id":"gid://gitlab/DiffNote/4052031517","lastEditedAt":"2026-10-20T16:44:58Z","lastEditedBy":null,"position":{"filePath":"internal/utils/utils.go","newLine":65,"oldLine":null},"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4158#note_4052031517"},{"author":{"bot":false,"id":"gid://gitlab/User/43441234","username":"Zaygalx1"},"body":"@GitLabDuo The behavior-regression finding is addressed in 0295354: the preserve-newlines option is now opt-in for issue, MR, discussion, and release rendering, while project README and `whatsnew` keep the previous behavior. A test also pins the default soft-newline behavior. Please re-review.","createdAt":"2026-10-20T16:41:27Z","discussion":{"id":"gid://gitlab/Discussion/b0ee0278adf51edda8924a24da8fe90ab31e046a","resolvable":false,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/Note/4052145200","lastEditedAt":"2026-10-20T16:41:27Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4158#note_4052145200"},{"author":{"bot":true,"id":"gid://gitlab/User/21826781","username":"GitLabDuo"},"body":":warning: @Zaygalx1, you don't have permission to create a pipeline for Code Review Flow in this project. Contact your administrator to update your permissions.\n\nError code: [DCR4003](https://gitlab.com/help/user/duo_agent_platform/flows/foundational_flows/code_review/troubleshooting.md#error-dcr4003)","createdAt":"2026-10-20T16:41:32Z","discussion":{"id":"gid://gitlab/Discussion/0bf84cb46137b86d12b741e6b4d098539aab005a","resolvable":false,"resolved":false,"resolvedBy":null},"id":"gid://gitlab/Note/4052145608","lastEditedAt":"2026-10-20T16:41:32Z","lastEditedBy":null,"position":null,"url":"https://gitlab.com/gitlab-org/cli/-/merge_requests/4158#note_4052145608"}]},"reviewers":{"pageInfo":{"hasNextPage":false,"endCursor":"eyJpZCI6IjEzMzU2In0"},"nodes":[{"bot":true,"id":"gid://gitlab/User/21826781","username":"GitLabDuo","mergeRequestInteraction":{"reviewState":"REVIEWED"}},{"bot":false,"id":"gid://gitlab/User/13356","username":"dblessing","mergeRequestInteraction":{"reviewState":"UNREVIEWED"}}]}}}}